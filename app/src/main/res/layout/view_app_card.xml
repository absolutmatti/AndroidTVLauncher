<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="156dp"
    android:layout_height="90dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/bg_card_selector">

    <!-- Wenn die App ein Vollbild-Banner wie Netflix oder Prime Video hat -->
    <ImageView
        android:id="@+id/ivCardBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:background="@drawable/bg_card_clip"
        android:clipToOutline="true"/>

    <!-- Content (Icon zentriert + Text drunter) für die blauen/schwarzen Boxen -->
    <LinearLayout
        android:id="@+id/layoutCardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <ImageView
            android:id="@+id/ivCardIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>