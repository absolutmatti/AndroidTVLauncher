<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header mit App-Icon und Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogAppIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_app_default" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="App-Name"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/dialogAppPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="com.example.package"
                android:textColor="@color/tv_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/tv_divider" />

    <!-- Aktionen (fokussierbar mit D-Pad) -->
    <!-- 1. Favoriten hinzufügen / entfernen -->
    <Button
        android:id="@+id/btnToggleFavorite"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dialog_item_selector"
        android:drawableStart="@drawable/ic_star_filled"
        android:drawablePadding="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/action_add_favorite"
        android:textAllCaps="false"
        android:textColor="@color/tv_text_primary"
        android:textSize="14sp" />

    <!-- 2. App-Info (Systemeinstellungen) -->
    <Button
        android:id="@+id/btnAppInfo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dialog_item_selector"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/action_app_info"
        android:textAllCaps="false"
        android:textColor="@color/tv_text_primary"
        android:textSize="14sp" />

    <!-- 3. Deinstallieren -->
    <Button
        android:id="@+id/btnUninstall"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dialog_item_selector"
        android:drawableStart="@drawable/ic_delete"
        android:drawablePadding="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/action_uninstall"
        android:textAllCaps="false"
        android:textColor="@color/tv_text_primary"
        android:textSize="14sp" />

    <!-- 4. Icon ändern -->
    <Button
        android:id="@+id/btnChangeIcon"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dialog_item_selector"
        android:drawableStart="@drawable/ic_image"
        android:drawablePadding="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/action_change_icon"
        android:textAllCaps="false"
        android:textColor="@color/tv_text_primary"
        android:textSize="14sp" />

    <!-- 5. Kategorie anpassen -->
    <Button
        android:id="@+id/btnChangeCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dialog_item_selector"
        android:drawableStart="@drawable/ic_apps_grid"
        android:drawablePadding="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/action_change_category"
        android:textAllCaps="false"
        android:textColor="@color/tv_text_primary"
        android:textSize="14sp" />

    <!-- 5. Abbrechen -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_item_selector"
        android:fontFamily="sans-serif"
        android:text="@string/dialog_cancel"
        android:textAllCaps="false"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
