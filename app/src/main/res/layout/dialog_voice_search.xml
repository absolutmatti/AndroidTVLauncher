<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Animierter Mikrofon-Orb oben -->
    <FrameLayout
        android:id="@+id/voiceOrbContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_voice_search_btn">

        <ImageView
            android:id="@+id/ivVoiceMicIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/voice_search_title"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <!-- Status-Text -->
    <TextView
        android:id="@+id/tvVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="@string/voice_search_listening"
        android:textColor="@color/tv_text_primary"
        android:textSize="18sp" />

    <!-- Gesprochener Text / Transkript -->
    <TextView
        android:id="@+id/tvVoiceTranscript"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-italic"
        android:gravity="center"
        android:text="@string/voice_search_prompt"
        android:textColor="@color/tv_accent_light"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/tv_divider" />

    <!-- Wetter-Ergebnis-Bereich (wird dynamisch eingeblendet) -->
    <LinearLayout
        android:id="@+id/voiceWeatherResultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivVoiceWeatherIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Wetter-Symbol"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_weather_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVoiceWeatherCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/tv_text_primary"
                android:textSize="17sp"
                tools:text="Berlin, DE" />

            <TextView
                android:id="@+id/tvVoiceWeatherCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                tools:text="Leicht bewölkt" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVoiceWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/tv_accent_light"
            android:textSize="26sp"
            tools:text="18°C" />
    </LinearLayout>

    <!-- App-Ergebnis-Bereich (Liste gefundener Apps) -->
    <LinearLayout
        android:id="@+id/voiceAppsResultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvVoiceAppsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/voice_search_matched_apps"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />

        <!-- Dynamisch gefüllter Container für App-Buttons -->
        <LinearLayout
            android:id="@+id/voiceAppListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Kein Treffer Hinweis -->
    <TextView
        android:id="@+id/tvVoiceNoResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Keine Treffer gefunden" />

    <!-- Beispiel-Vorschläge bei Start -->
    <LinearLayout
        android:id="@+id/voiceSuggestionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/chipVoiceSuggestWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="„Wetter“"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipVoiceSuggestStreaming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="„Streaming“"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipVoiceSuggestGames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="„Spiele“"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/tv_divider" />

    <!-- Steuerungsbuttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVoiceRetry"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dialog_item_selector"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Erneut sprechen"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnVoiceClose"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_item_selector"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/dialog_cancel"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
