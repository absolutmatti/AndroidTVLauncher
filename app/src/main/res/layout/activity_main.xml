<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Sleek Top Status Bar (Top Left: Settings, WiFi, Temp, Weather Icon; Top Right: User, Notifications, Time, Date) -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <!-- Space in upper middle area for background wallpaper/ambience -->
    <!-- Container für Leanback RowsSupportFragment -->
    <FrameLayout
        android:id="@+id/rowsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false" />

</LinearLayout>
