<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fokussierter Zustand: Glowing Neon Halo -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#40A855F7"
                android:endColor="#4006B6D4"
                android:type="linear" />
            <stroke
                android:width="2.5dp"
                android:color="@color/tv_accent_cyan" />
        </shape>
    </item>
    <!-- Normaler Zustand: Glass Capsule -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1AFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#20FFFFFF" />
        </shape>
    </item>
</selector>
