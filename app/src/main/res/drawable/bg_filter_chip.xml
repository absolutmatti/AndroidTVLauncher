<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fokus mit Fernbedienung (D-Pad) -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#BA68C8" />
            <stroke
                android:width="2.5dp"
                android:color="@color/tv_text_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#3D214C" />
            <stroke
                android:width="2.5dp"
                android:color="@color/tv_accent" />
        </shape>
    </item>
    <!-- Aktiv selektierte Kategorie (nicht fokussiert) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/tv_accent" />
        </shape>
    </item>
    <!-- Normaler inaktiver Zustand -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/tv_surface_card" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
