<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Electric Cyan / Purple Orb Glow -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#A855F7"
                android:endColor="#06B6D4"
                android:type="linear" />
            <stroke
                android:width="3dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#80A855F7"
                android:endColor="#8006B6D4"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#60FFFFFF" />
        </shape>
    </item>
</selector>
